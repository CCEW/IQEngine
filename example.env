# This is an example .env file, copy the file to ".env", fill it in, and redo the npm start
IQENGINE_CONNECTION_INFO={ "settings": [{"accountName": "aerolake","containerName": "aerolake-captures","awsAccessKeyId": "","awsSecretAccessKey": "","s3EndpointUrl": "https://minio-api.fast.etsmtl.ca","s3Prefix": "","s3VerifySsl": false,"name": "Aerolake Captures","description": "SigMF recordings from FAST MinIO","public": true,"owners": ["IQEngine-Admin"],"readers": []},{"accountName": "fast-minio","containerName": "sigmf","awsAccessKeyId": "","awsSecretAccessKey": "","s3EndpointUrl": "https://minio-api.fast.etsmtl.ca","s3Prefix": "","s3VerifySsl": false,"name": "FAST MinIO SigMF","description": "SigMF bucket on the same FAST MinIO endpoint","public": true,"owners": ["IQEngine-Admin"],"readers": []}]}
IQENGINE_FEATURE_FLAGS={"allowRefreshing": true, "useIQEngineOutReach": true, "displayIQEngineGitHub": true, "hideInternalBranding": true}
IQENGINE_PLUGINS=[{"name": "BuiltIn",  "url": "plugins:8000"}, {"name": "e2e tests", "url": "http://127.0.0.1:8000/plugins"}]
IQENGINE_METADATA_DB_CONNECTION_STRING="mongodb://iqengine:iqengine@mongo:27017"
IN_MEMORY_DB=0
IQENGINE_BACKEND_LOCAL_FILEPATH=

MONGO_USERNAME=iqengine
MONGO_PASSWORD=iqengine

# Optional S3-compatible datasource, such as FAST MinIO.
# Leave MINIO_PREFIX empty to index all signal folders in the bucket.
MINIO_ENDPOINT_URL=
MINIO_BUCKET=
MINIO_PREFIX=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_DATASOURCE_NAME=
MINIO_VERIFY_SSL=
