IQENGINE_CONNECTION_INFO={ "settings": [{"accountName": "aerolake","containerName": "aerolake-captures","awsAccessKeyId": "QMtHywCrDExm2sTtCHLC","awsSecretAccessKey": "QxXCW203rsYmMVJ9kC7gFp9mTbLLhgEtnBlou2m9","s3EndpointUrl": "https://minio-api.fast.etsmtl.ca","s3Prefix": "","s3VerifySsl": false,"name": "Aerolake Captures","description": "SigMF recordings from FAST MinIO","public": true,"owners": ["IQEngine-Admin"],"readers": []},{"accountName": "fast-minio","containerName": "sigmf","awsAccessKeyId": "QMtHywCrDExm2sTtCHLC","awsSecretAccessKey": "QxXCW203rsYmMVJ9kC7gFp9mTbLLhgEtnBlou2m9","s3EndpointUrl": "https://minio-api.fast.etsmtl.ca","s3Prefix": "","s3VerifySsl": false,"name": "FAST MinIO SigMF","description": "SigMF bucket on the same FAST MinIO endpoint","public": true,"owners": ["IQEngine-Admin"],"readers": []}]}
IQENGINE_FEATURE_FLAGS={"allowRefreshing": true, "useIQEngineOutReach": true, "displayIQEngineGitHub": true, "hideInternalBranding": true}
IQENGINE_PLUGINS=[{"name":"IQEngine.org", "url":"https://iqengine-staging-plugins.agreeableforest-695e4014.eastus2.azurecontainerapps.io/plugins"}, {"name":"Local", "url": "http://localhost:8000/plugins" }]
IQENGINE_METADATA_DB_CONNECTION_STRING="<YOUR MONGO DB CONNECTION STRING>"
IN_MEMORY_DB=0
IQENGINE_BACKEND_LOCAL_FILEPATH=

MONGO_USERNAME=iqengine
MONGO_PASSWORD=iqengine

# Optional S3-compatible datasource, such as FAST MinIO.
# Leave MINIO_PREFIX empty to index all signal folders in the bucket.
MINIO_ENDPOINT_URL=
MINIO_BUCKET=
MINIO_PREFIX=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_DATASOURCE_NAME=
MINIO_VERIFY_SSL=
